# Browser-safe Supabase configuration only.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Keep checkout controls disabled until Paymob Edge Functions and secrets are deployed.
VITE_PAYMENTS_ENABLED=false
VITE_PREMIUM_MONTHLY_DISPLAY_EGP=
VITE_PREMIUM_YEARLY_DISPLAY_EGP=

# Server-side AI configuration belongs in Supabase Edge Function secrets.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash-lite
# APP_ORIGINS=https://your-domain.example,http://localhost:5173

# Production app/payment configuration (server-side values belong in Supabase Edge Function secrets).
# APP_URL=https://your-domain.example
# PAYMOB_SECRET_KEY=sk_test_or_sklive_...
# PAYMOB_PUBLIC_KEY=pk_test_or_pklive_...
# PAYMOB_HMAC_SECRET=...
# PAYMOB_INTEGRATION_IDS=1234567,7654321
# Paymob supports cards, wallets, Apple Pay and Google Pay when enabled on your merchant account.
# Optional effective-fee gross-up: set the actual blended processor rate for your account.
# PAYMENT_FEE_PERCENT=0
# PAYMENT_FIXED_FEE_CENTS=0
# VITE_PAYMENT_FEE_PERCENT=0
# VITE_PAYMENT_FIXED_FEE_EGP=0
# PREMIUM_MONTHLY_AMOUNT_CENTS=...
# PREMIUM_YEARLY_AMOUNT_CENTS=...

# Gem top-up display prices (EGP)
VITE_GEMS_PACK_120_DISPLAY_EGP=49
VITE_GEMS_PACK_300_DISPLAY_EGP=99
VITE_GEMS_PACK_700_DISPLAY_EGP=199
VITE_GEMS_PACK_1600_DISPLAY_EGP=399

# Gem top-up Paymob amounts (piastres)
# Keep these server-side values aligned with the public display prices.
GEMS_PACK_120_AMOUNT_CENTS=4900
GEMS_PACK_300_AMOUNT_CENTS=9900
GEMS_PACK_700_AMOUNT_CENTS=19900
GEMS_PACK_1600_AMOUNT_CENTS=39900

# Optional payment gross-up: these are your target merchant-net amounts.
# The checkout amount is calculated server-side so the configured effective processor fee
# is added on top. Do not guess these values; use the actual blended rate in your merchant account.
# PREMIUM_MONTHLY_NET_AMOUNT_CENTS=...
# PREMIUM_YEARLY_NET_AMOUNT_CENTS=...
# GEMS_PACK_120_NET_AMOUNT_CENTS=...
# GEMS_PACK_300_NET_AMOUNT_CENTS=...
# GEMS_PACK_700_NET_AMOUNT_CENTS=...
# GEMS_PACK_1600_NET_AMOUNT_CENTS=...
# PAYMENT_FEE_PERCENT=0
# PAYMENT_FIXED_FEE_CENTS=0
# Optional per-method Paymob integration IDs. If omitted, PAYMOB_INTEGRATION_IDS is used.
# PAYMOB_METHOD_INTEGRATION_IDS={"cards":[1234567],"apple_pay":[2345678],"google_pay":[3456789],"wallets":[4567890]}

# Optional support contact shown in the in-app Contact panel.
# VITE_SUPPORT_EMAIL=support@your-domain.example

# Optional: URL Supabase should return to after password reset.
# For local browser testing: http://127.0.0.1:5173/
VITE_PASSWORD_RESET_REDIRECT_URL=
